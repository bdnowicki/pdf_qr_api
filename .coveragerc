[run]
source = app,main
omit = 
    */tests/*
    */migrations/*
    */__init__.py
    */settings.py
    */config.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError
    except ImportError:
    if TYPE_CHECKING:

[html]
directory = coverage_html 